{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node", "react"],
    "lib": ["ES2022"],
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["index.server.ts", "index.client.tsx", "server/**/*.ts", "client/**/*.tsx", "client/**/*.ts", "shared/**/*.ts", "tests/**/*.ts"]
}
